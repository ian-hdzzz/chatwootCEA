# Configuración de Chatwoot para Embedding y CORS

# Frontend URL - URL base de tu aplicación Chatwoot
FRONTEND_URL=http://localhost:3000

# Dominios permitidos para embedding (frame-ancestors en CSP)
# Separa múltiples dominios con comas
# Ejemplos:
# - Para desarrollo local: http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001
# - Para producción: https://tudominio.com,https://www.tudominio.com
# - Para permitir TODOS (solo para testing, INSEGURO): *
ALLOWED_FRAME_ANCESTORS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001

# Habilitar CORS para API (solo si necesitas hacer llamadas API desde otros dominios)
ENABLE_API_CORS=true

# Modo API-only (permite todos los métodos CORS en desarrollo)
CW_API_ONLY_SERVER=false
