# ===================================
# CONFIGURACIÓN MÍNIMA PARA CLOUD RUN
# ===================================

# 🔐 SEGURIDAD (OBLIGATORIO - Genera nuevos valores)
SECRET_KEY_BASE=GENERA_CON_openssl_rand_hex_64

# 🌐 URL DE TU APLICACIÓN (Actualiza después del primer deploy)
FRONTEND_URL=https://chatwootcea-xxxxx-uc.a.run.app
FORCE_SSL=true

# 🗄️ BASE DE DATOS (Cloud SQL)
# Opción 1: Usando Unix Socket (recomendado para Cloud SQL)
POSTGRES_HOST=/cloudsql/clever-obelisk-277705:us-central1:TU-INSTANCIA-SQL
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=TU_PASSWORD_SEGURO
POSTGRES_DATABASE=chatwoot_production
RAILS_ENV=production

# Opción 2: Usando IP privada
# POSTGRES_HOST=10.x.x.x
# POSTGRES_PORT=5432

# 🔴 REDIS (Memorystore o Cloud Memory Store)
# Opción 1: Memorystore
REDIS_URL=redis://10.x.x.x:6379
REDIS_PASSWORD=TU_REDIS_PASSWORD

# Opción 2: Redis externo (ej: Upstash, Redis Cloud)
# REDIS_URL=rediss://default:password@host:port

# 📧 EMAIL (Opcional - usa SendGrid, Mailgun, etc)
MAILER_SENDER_EMAIL=Chatwoot <noreply@tudominio.com>
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=TU_SENDGRID_API_KEY
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# 📁 ALMACENAMIENTO (Obligatorio para producción)
ACTIVE_STORAGE_SERVICE=google
# Crea un bucket en GCS y configura:
GCS_PROJECT=clever-obelisk-277705
GCS_BUCKET=chatwoot-storage-bucket
# Las credenciales se manejan automáticamente en Cloud Run

# 📊 LOGS
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# 🚫 SEGURIDAD
ENABLE_ACCOUNT_SIGNUP=false
RAILS_MAX_THREADS=5

# ⏱️ TIMEOUTS (Importante para Cloud Run)
POSTGRES_STATEMENT_TIMEOUT=30s
RACK_TIMEOUT_SERVICE_TIMEOUT=60

# 🔔 NOTIFICACIONES (Opcional)
ENABLE_PUSH_RELAY_SERVER=false
