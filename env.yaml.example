# ==========================================
# TEMPLATE FOR CLOUD RUN ENVIRONMENT VARS
# ==========================================
# Copy this file to 'env.yaml' and fill in the values.
# DO NOT COMMIT 'env.yaml' TO GIT.

# --- Core Configuration ---
RAILS_ENV: "production"
NODE_ENV: "production"
RAILS_LOG_TO_STDOUT: "true"
LOG_LEVEL: "info"
# PORT is reserved by Cloud Run, do not set it manually here.

# --- Security ---
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE: "CHANGE_ME"

# --- Database (Cloud SQL) ---
# Format: /cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
POSTGRES_HOST: "/cloudsql/YOUR_PROJECT:YOUR_REGION:chatwoot-db"
POSTGRES_USERNAME: "chatwoot_user"
POSTGRES_PASSWORD: "CHANGE_ME"
POSTGRES_DATABASE: "chatwoot_production"

# --- Redis (External) ---
# Use Upstash or Redis Cloud URL
REDIS_URL: "rediss://default:password@host:port"

# --- Application Definitions ---
# Update this after the first deployment when you get the Cloud Run URL
FRONTEND_URL: "https://SERVICE_NAME-HASH-uc.a.run.app"
FORCE_SSL: "true"

# --- Storage (Google Cloud Storage) ---
ACTIVE_STORAGE_SERVICE: "google"
GCS_PROJECT: "YOUR_PROJECT_ID"
GCS_BUCKET: "your-storage-bucket-name"

# --- Email (SMTP) ---
# Example for SendGrid
MAILER_SENDER_EMAIL: "Chatwoot <noreply@yourdomain.com>"
SMTP_ADDRESS: "smtp.sendgrid.net"
SMTP_PORT: "587"
SMTP_USERNAME: "apikey"
SMTP_PASSWORD: "CHANGE_ME" # Your SendGrid API Key
SMTP_AUTHENTICATION: "plain"
SMTP_ENABLE_STARTTLS_AUTO: "true"

# --- Feature Flags ---
ENABLE_ACCOUNT_SIGNUP: "false"

# --- Sidekiq Configuration ---
# Number of threads per Sidekiq process (adjust based on memory)
SIDEKIQ_CONCURRENCY: "10"
# Enable detailed dequeue logging (optional, for debugging)
ENABLE_SIDEKIQ_DEQUEUE_LOGGER: "false"
